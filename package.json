{
  "name": "delphi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.3.0",
  "description": "delphi —— 一面照向内心的镜子。自我认知 Agent（CLI 本地模式 + Web）",
  "scripts": {
    "build": "pnpm --filter @delphi/core build && pnpm --filter @delphi/cli build",
    "test": "pnpm --filter @delphi/core test",
    "build:test": "pnpm build && pnpm test",
    "delphi": "node apps/cli/dist/index.js",
    "dev": "node apps/cli/dist/index.js",
    "link:global": "pnpm --filter @delphi/cli link --global",
    "web": "pnpm --filter @delphi/web dev",
    "web:build": "pnpm --filter @delphi/web build"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=23.4"
  }
}
