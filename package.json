{
  "name": "delphi",
  "version": "0.1.0",
  "private": true,
  "description": "delphi —— 一面照向内心的镜子。自我认知 Agent（CLI 本地模式）",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @delphi/core && npm run build -w @delphi/cli",
    "test": "npm test -w @delphi/core",
    "build:test": "npm run build && npm test",
    "delphi": "node packages/cli/dist/index.js",
    "dev": "node packages/cli/dist/index.js",
    "link:global": "npm link -w @delphi/cli"
  },
  "engines": {
    "node": ">=20"
  }
}
